# ==============================================================================
# AURA SALON — PRODUCTION & LOCAL ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================
# Copy relevant blocks to your local .env files (client/.env, server/.env)
# or configure them in the Vercel Project Dashboard (Settings > Environment Variables).
#
# Classification:
# 1. SECRET VARIABLES — Never commit to git or expose to the client bundle:
#    - DATABASE_AUTH_TOKEN / TURSO_AUTH_TOKEN
#    - AUTH_SECRET
#    - OWNER_PIN / STAFF_PIN
# 2. SERVER VARIABLES — Injected into the backend / server service
# 3. CLIENT VARIABLES — Prefixed with VITE_, accessible in client bundles
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Vercel 'server' service / server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=production

# Database (Turso libSQL cloud database for persistent production data)
# Create a free database at https://turso.tech (CLI: turso db create aura-salon)
DATABASE_URL=libsql://aura-salon-<username>.turso.io
DATABASE_AUTH_TOKEN=your-turso-database-auth-token-here

# Local development fallback (uncomment for local SQLite disk storage):
# DATABASE_URL=file:./data/salon.db
# DATABASE_AUTH_TOKEN=

# Cryptographic token signing secret (HMAC-SHA256)
# Generate a strong 32+ character random string in production (e.g., openssl rand -hex 32)
AUTH_SECRET=generate-a-strong-random-secret-key-for-production-session-tokens

# Role-Based Authentication PINs (Validated server-side only)
STAFF_PIN=1234
OWNER_PIN=5678
BARBER_PIN=1234

# Demo Evaluator Quick-Fill Credentials
DEMO_CUSTOMER_PHONE=9876543210
DEMO_CUSTOMER_CODE=123456

# Allowed CORS Origins (comma-separated if multiple)
# In production on Vercel, requests from the same origin or *.vercel.app are automatically permitted
CLIENT_ORIGIN=https://aura-salon.vercel.app

# Salon Business Policy
NO_SHOW_GRACE_MINUTES=10
SALON_TIMEZONE=Asia/Kolkata

# Local HTTP Port (Used only for local standalone execution, ignored on Vercel)
PORT=4000

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (Vercel 'client' service / client/.env)
# ------------------------------------------------------------------------------
# In Vercel Multiple Services deployment, the frontend and backend share the same
# origin domain. Leave VITE_API_URL empty/unset in production so requests use
# relative paths (/api/*).
#
# For local development in client/.env:
# VITE_API_URL=http://localhost:4000
VITE_API_URL=

# Optional: Dedicated external stateful Socket.IO server URL (e.g. Render / Railway).
# If left empty, the application uses intelligent polling fallback over Vercel serverless.
# VITE_SOCKET_URL=https://aura-salon-backend.onrender.com
VITE_SOCKET_URL=
