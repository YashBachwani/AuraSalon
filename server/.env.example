# Server Configuration (Local Development & Serverless Deployment)
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Single SQLite / libSQL database engine via @libsql/client
# Local development default: file:./data/salon.db
# Automated tests: :memory:
# Production (Free Turso libSQL): libsql://<your-db>.turso.io
DATABASE_URL=file:./data/salon.db
DATABASE_AUTH_TOKEN=

# Cryptographic token secret (HMAC-SHA256)
AUTH_SECRET=aura_salon_jwt_hmac_secret_key_2026

# Simple Staff & Owner PIN Authentication (validated server-side)
STAFF_PIN=1234
OWNER_PIN=5678
BARBER_PIN=1234

# Demo Evaluator Credentials
DEMO_CUSTOMER_PHONE=9876543210
DEMO_CUSTOMER_CODE=123456

# Queue Policy Settings
NO_SHOW_GRACE_MINUTES=10
SALON_TIMEZONE=Asia/Kolkata
