# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (Single SQLite / libSQL engine via @libsql/client)
# Local development default: file:./data/salon.db
# Automated tests: :memory:
# Production (Free Turso libSQL): libsql://<your-db>.turso.io
DATABASE_URL=file:./data/salon.db
DATABASE_AUTH_TOKEN=

# Simple Staff & Owner PIN Authentication (validated server-side)
STAFF_PIN=1234
OWNER_PIN=5678

# Queue Policy Settings
NO_SHOW_GRACE_MINUTES=10
SALON_TIMEZONE=Asia/Kolkata
