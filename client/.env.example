# Backend API & Socket.IO Origin
# Local development default: http://localhost:4000
# Production on Vercel: leave empty (defaults to same-origin relative /api paths)
# Production with external backend (Render / Railway): https://your-backend.onrender.com
VITE_API_URL=http://localhost:4000

# Optional external real-time WebSocket server URL
# VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=
